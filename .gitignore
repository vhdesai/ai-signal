# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini
*~

# Hugging Face / model caches
.cache/

# Raw news digest markdown (source data — not published)
/news/
/digests/

# SQLite transient sidecar files
*.db-journal
*.db-wal
*.db-shm

# Transient URL-repair status / control files
/indexes/repair-status.json
/indexes/repair.stop
/site/.build-manifest.json

# Per-stage pipeline run logs (audit trail — superseded by indexes/run-daily.log
# and the console output kept per session). Adds ~7 tiny files per rebuild
# that inflate the git delta with no long-term value.
/indexes/runs/

# Pipeline SQLite + ChromaDB stores. These are derived artifacts rebuilt by
# the pipeline from /news/ markdowns and are synchronized between the
# Obsidian authoring pipeline and ext-host via scripts/sync-data.ps1 (which
# runs OUTSIDE git). They're individually >50 MB and grow with every rebuild,
# so tracking them in git triggers GitHub's large-file warnings and bloats
# the pack. The deployed site (/site/) is independent of these files.
/indexes/*.db
/indexes/chroma/

# IDE / editor settings
.vscode/
.idea/
*.swp
*.swo

# Node (for wrangler CLI)
node_modules/

# Build artifacts
dist/
build/
*.egg

# Environment variables
.env
.env.local

# Obsidian per-user UI state
.obsidian/workspace.json
.obsidian/workspace-mobile.json
